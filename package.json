{
  "name": "simple-ecommerce-web-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo wrapper for the ShopSphere frontend and backend folders.",
  "scripts": {
    "start": "node scripts/start-all.js",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "start:all": "node scripts/start-all.js",
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "build:css": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "license": "MIT"
}
